<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Zyvrok — Content Repurposing Studio</title>
  <meta name="description" content="Turn YouTube videos, long-form articles, and draft notes into platform-native LinkedIn posts, Twitter/X threads, and newsletter summaries." />
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  
  <!-- Typography: Plus Jakarta Sans & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <script id="tailwind-config">
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            "base": "#F7F6F2",
            "surface": "#FFFFFF",
            "subtle": "#EFECE6",
            "subtle-hover": "#E6E2D8",
            "border-crisp": "#E2DFD7",
            "border-highlight": "#CBC7BD",
            "text-primary": "#181715",
            "text-secondary": "#68655E",
            "text-muted": "#8A877E",
            "accent": "#C24A2A",
            "accent-hover": "#A83C1F",
            "accent-subtle": "#FAEEE9",
            "primary": "#181715",
            "primary-container": "#2B2925",
            "secondary": "#68655E",
            "background": "#F7F6F2",
            "on-background": "#181715",
            "on-surface": "#181715",
            "surface-container": "#EFECE6",
            "surface-container-low": "#F7F6F2",
            "surface-container-lowest": "#FFFFFF",
            "outline-variant": "#E2DFD7"
          },
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', '-apple-system', 'BlinkMacSystemFont', 'system-ui', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'ui-monospace', 'monospace']
          }
        }
      }
    }
  </script>
  <style>
    body {
      background-color: #F7F6F2;
      color: #181715;
    }
    a:focus-visible, button:focus-visible {
      outline: 2px solid #C24A2A;
      outline-offset: 2px;
    }
  </style>
</head>
<body class="bg-base text-text-primary font-sans antialiased selection:bg-accent-subtle selection:text-accent min-h-screen flex flex-col">

  <!-- Header Navigation -->
  <header class="sticky top-0 z-50 bg-[#F7F6F2]/90 backdrop-blur-md border-b border-border-crisp">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
      
      <!-- Brand Monogram & Name -->
      <a href="index.html" class="flex items-center gap-3 group">
        <div class="w-9 h-9 rounded-xl bg-primary text-white flex items-center justify-center font-bold text-sm tracking-tight transition-transform group-hover:scale-95 shadow-sm">
          <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16L7 20h13"/>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-extrabold text-lg tracking-tight leading-none text-text-primary">Zyvrok</span>
          <span class="text-[10px] font-mono text-text-muted tracking-tight mt-0.5 lowercase">turn links into signal</span>
        </div>
      </a>

      <!-- Navigation Links -->
      <nav class="hidden md:flex items-center gap-7 text-xs font-semibold text-text-secondary">
        <a href="#features" class="hover:text-text-primary transition-colors">Engine</a>
        <a href="#preview" class="hover:text-text-primary transition-colors">Studio Interface</a>
        <a href="#pricing" class="hover:text-text-primary transition-colors">Pricing</a>
      </nav>

      <!-- Action Buttons -->
      <div class="flex items-center gap-3">
        <a href="login_sign_up_responsive/code.html" class="text-xs font-semibold text-text-secondary hover:text-text-primary px-2.5 py-1.5 transition-colors">
          Sign In
        </a>
        <a href="repurpose_studio_responsive/code.html" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-primary text-white text-xs font-bold hover:bg-primary-container transition-colors shadow-sm">
          <span>Open Studio</span>
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </header>

  <!-- Hero Section (Generous Whitespace, Apple-Inspired Scale, No Fake Pill Badge) -->
  <section class="pt-20 pb-16 border-b border-border-crisp bg-gradient-to-b from-white/70 to-base">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      
      <!-- Solid High-Contrast Headline (Zero gradient text) -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-text-primary leading-[1.14]">
        Turn raw video and text into ready-to-publish social copy.
      </h1>

      <!-- Specific Subtitle -->
      <p class="mt-6 text-base sm:text-lg text-text-secondary max-w-2xl mx-auto leading-relaxed">
        Extract transcripts from YouTube or blog URLs. Zyvrok formats them into a 3-part distribution bundle: LinkedIn post, X thread, and newsletter summary.
      </p>

      <!-- Primary Action Buttons -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="repurpose_studio_responsive/code.html" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-primary text-white text-xs font-bold hover:bg-primary-container transition-colors shadow-sm">
          <span>Start in Studio</span>
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a href="#pricing" class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3.5 rounded-xl bg-surface border border-border-crisp text-text-primary text-xs font-semibold hover:bg-subtle transition-colors shadow-2xs">
          View Pricing (from ₹199)
        </a>
      </div>

      <!-- Real Metrics Strip -->
      <div class="mt-12 pt-8 border-t border-border-crisp/80 flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-[11px] font-mono text-text-secondary">
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-accent"></span>
          <span class="text-text-primary font-bold">5</span>
          <span>Free trial credits</span>
        </div>
        <span class="text-border-crisp hidden sm:inline">|</span>
        <div class="flex items-center gap-1.5">
          <span class="text-accent font-bold">3</span>
          <span>Deliverables per link</span>
        </div>
        <span class="text-border-crisp hidden sm:inline">|</span>
        <div class="flex items-center gap-1.5">
          <span class="text-text-primary font-bold">₹0</span>
          <span>Recurring subscription fees</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Product Preview Window Frame (Real Studio Representation) -->
  <section id="preview" class="py-16 bg-base border-b border-border-crisp">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      
      <div class="mb-5 flex items-center justify-between">
        <div>
          <span class="text-[11px] font-mono uppercase tracking-wider text-accent font-bold">Repurpose Studio</span>
          <h2 class="text-lg font-bold text-text-primary tracking-tight mt-0.5">One input. Three publication-ready drafts.</h2>
        </div>
        <a href="repurpose_studio_responsive/code.html" class="inline-flex items-center gap-1 text-xs font-semibold text-accent hover:text-accent-hover transition-colors">
          <span>Open live studio</span>
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
          </svg>
        </a>
      </div>

      <!-- Studio Window Container Frame -->
      <div class="rounded-2xl border border-border-crisp bg-surface overflow-hidden shadow-sm">
        
        <!-- Application Window Chrome -->
        <div class="bg-subtle px-4 py-3 border-b border-border-crisp flex items-center justify-between text-xs text-text-secondary">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-[#DCD8CF] border border-border-crisp"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#DCD8CF] border border-border-crisp"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#DCD8CF] border border-border-crisp"></span>
            <span class="ml-2 font-mono text-[11px] text-text-secondary">zyvrok-ai.vercel.app/studio</span>
          </div>
          <div class="flex items-center gap-2 font-mono text-[11px]">
            <span class="flex items-center gap-1.5 text-accent font-semibold">
              <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
              <span>Workspace Ready</span>
            </span>
          </div>
        </div>

        <!-- Studio Internal Grid Mockup -->
        <div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-border-crisp text-left">
          
          <!-- Left Configuration & Input Panel -->
          <div class="lg:col-span-5 p-6 space-y-4 bg-surface">
            <div>
              <label class="block text-[11px] font-mono uppercase font-semibold text-text-secondary mb-2">Input Source</label>
              <div class="grid grid-cols-3 gap-1 p-1 bg-subtle rounded-xl border border-border-crisp text-center text-xs font-semibold">
                <span class="py-1.5 text-text-secondary">Text</span>
                <span class="py-1.5 text-text-secondary">Article</span>
                <span class="py-1.5 bg-primary text-white rounded-lg shadow-xs">YouTube</span>
              </div>
            </div>

            <div>
              <label class="block text-[11px] font-mono uppercase font-semibold text-text-secondary mb-2">Source URL</label>
              <div class="p-2.5 rounded-xl bg-[#FAF9F6] border border-border-crisp text-xs font-mono text-text-primary break-all">
                https://youtube.com/watch?v=kCc8FmEb1nY
              </div>
              <p class="text-[10px] text-text-muted font-mono mt-1">Andrej Karpathy: State of GPT & LLM Pipelines (Transcript extracted)</p>
            </div>

            <div>
              <label class="block text-[11px] font-mono uppercase font-semibold text-text-secondary mb-2">Framework & Tone</label>
              <div class="grid grid-cols-2 gap-1.5 text-xs font-medium">
                <span class="p-2 rounded-lg border border-primary bg-primary text-white font-bold flex items-center justify-between">
                  <span>Professional</span>
                  <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
                </span>
                <span class="p-2 rounded-lg border border-border-crisp text-text-secondary bg-surface">Contrarian</span>
                <span class="p-2 rounded-lg border border-border-crisp text-text-secondary bg-surface">Technical</span>
                <span class="p-2 rounded-lg border border-border-crisp text-text-secondary bg-surface">Storytelling</span>
              </div>
            </div>

            <div class="pt-3 border-t border-border-crisp flex items-center justify-between">
              <span class="text-[11px] font-mono text-text-secondary">Cost: 1 Credit</span>
              <a href="repurpose_studio_responsive/code.html" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-primary text-white text-xs font-bold hover:bg-primary-container transition-colors shadow-sm">
                <span>Morph Content</span>
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>

          <!-- Right Studio Output Draft Editor -->
          <div class="lg:col-span-7 p-6 space-y-4 bg-surface flex flex-col justify-between">
            <div>
              <!-- Output Tabs -->
              <div class="flex items-center justify-between border-b border-border-crisp pb-3 mb-3">
                <div class="flex items-center gap-1.5 text-xs font-semibold">
                  <span class="px-3 py-1.5 rounded-lg bg-primary text-white shadow-xs">LinkedIn Post</span>
                  <span class="px-3 py-1.5 text-text-secondary hover:text-text-primary">X Thread (5)</span>
                  <span class="px-3 py-1.5 text-text-secondary hover:text-text-primary">Newsletter</span>
                </div>
                <span class="text-[11px] font-mono text-text-secondary">184 words · 1,142 chars</span>
              </div>

              <!-- Refine Action Bar -->
              <div class="flex items-center gap-1.5 text-[11px] font-mono text-text-secondary pb-3 mb-3 border-b border-border-crisp/60 overflow-x-auto">
                <span class="text-text-primary font-bold">Refine:</span>
                <span class="px-2.5 py-1 rounded-md border border-border-crisp bg-subtle text-text-secondary hover:text-text-primary">⚡ Shorten</span>
                <span class="px-2.5 py-1 rounded-md border border-border-crisp bg-subtle text-text-secondary hover:text-text-primary">🔥 Stronger Hook</span>
                <span class="px-2.5 py-1 rounded-md border border-border-crisp bg-subtle text-text-secondary hover:text-text-primary">🎯 Contrarian Take</span>
              </div>

              <!-- Real Formatted Output -->
              <div class="text-xs text-text-primary font-sans leading-relaxed space-y-3 bg-[#FAF9F6] p-4 rounded-xl border border-border-crisp">
                <p class="font-bold text-text-primary">
                  Most teams build LLM wrappers without understanding where inference economics break down.
                </p>
                <p class="text-text-secondary">
                  In Karpathy's architecture review, three operational constraints determine whether a generative application survives production scale:
                </p>
                <div class="space-y-1.5 pl-3 border-l-2 border-accent font-mono text-[11px] text-text-secondary">
                  <p>1. Pretraining teaches world models; fine-tuning only adjusts the conversational format.</p>
                  <p>2. Reinforcement learning from human feedback introduces alignment tax and hallucinations.</p>
                  <p>3. Context window retrieval is not memory—it is working scratchpad space.</p>
                </div>
                <p class="text-text-secondary">
                  Optimize your pipeline for context precision rather than model parameter scale. The real edge is retrieval density.
                </p>
              </div>
            </div>

            <!-- Footer actions of preview -->
            <div class="pt-3 flex items-center justify-between border-t border-border-crisp text-xs">
              <span class="text-[11px] font-mono text-text-secondary">Interactive draft editor active</span>
              <a href="repurpose_studio_responsive/code.html" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-border-crisp bg-surface font-semibold text-text-primary text-xs hover:bg-subtle transition-colors shadow-2xs">
                <span>Open in Studio</span>
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Core Features Bento Grid -->
  <section id="features" class="py-20 border-b border-border-crisp bg-surface">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      
      <div class="max-w-2xl mb-14">
        <span class="text-[11px] font-mono uppercase tracking-wider text-accent font-bold">Engine Mechanics</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-text-primary tracking-tight mt-1">
          Designed for high-signal publishing across multiple channels.
        </h2>
        <p class="text-sm text-text-secondary mt-2">
          Generic AI tools output surface-level summaries. Zyvrok isolates the underlying argument and reconstructs it using native platform psychology.
        </p>
      </div>

      <!-- Bento Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Large Card 1 (Span 2) -->
        <div class="md:col-span-2 p-7 sm:p-9 rounded-2xl bg-base border border-border-crisp space-y-4 hover:border-border-highlight transition-colors">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">01 · Multi-Platform Atomization</span>
            <span class="text-[11px] font-mono text-text-secondary">Single Extraction Pipeline</span>
          </div>
          <h3 class="text-xl font-bold text-text-primary">One URL yields three distinct, platform-native deliverables.</h3>
          <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
            Paste a public YouTube link or blog article URL. Zyvrok parses the core text or transcript and generates:
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 text-xs">
            <div class="p-4 rounded-xl bg-surface border border-border-crisp space-y-1 shadow-2xs">
              <span class="font-bold text-text-primary block">LinkedIn Post</span>
              <span class="text-text-secondary text-[11px]">2-line scroll-stopping hook, friction analysis, actionable bullets.</span>
            </div>
            <div class="p-4 rounded-xl bg-surface border border-border-crisp space-y-1 shadow-2xs">
              <span class="font-bold text-text-primary block">X / Twitter Thread</span>
              <span class="text-text-secondary text-[11px]">5 to 6 standalone tweets with narrative pacing and bookmark incentives.</span>
            </div>
            <div class="p-4 rounded-xl bg-surface border border-border-crisp space-y-1 shadow-2xs">
              <span class="font-bold text-text-primary block">Newsletter Brief</span>
              <span class="text-text-secondary text-[11px]">Executive summary for Substack, Beehiiv, or internal team briefings.</span>
            </div>
          </div>
        </div>

        <!-- Card 2 (Span 1) -->
        <div class="p-7 sm:p-9 rounded-2xl bg-base border border-border-crisp space-y-4 flex flex-col justify-between hover:border-border-highlight transition-colors">
          <div class="space-y-3">
            <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">02 · Ghostwriting Frameworks</span>
            <h3 class="text-xl font-bold text-text-primary">No robotic AI clichés.</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Our prompt pipeline strictly bans generic language like "game changer", "delve into", or empty filler. Tone presets include Thought Leader, Contrarian, Technical, Casual, and Storytelling.
            </p>
          </div>
          <div class="p-3.5 rounded-xl bg-surface border border-border-crisp text-[11px] font-mono text-text-secondary">
            0 markdown asterisks in social text, clean spacing, and clear arguments.
          </div>
        </div>

        <!-- Card 3 (Span 1) -->
        <div class="p-7 sm:p-9 rounded-2xl bg-base border border-border-crisp space-y-4 flex flex-col justify-between hover:border-border-highlight transition-colors">
          <div class="space-y-3">
            <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">03 · In-App Draft Editor</span>
            <h3 class="text-xl font-bold text-text-primary">Refine copy before copying.</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Edit text directly in the output pane. Use 1-click refinement buttons to shorten copy, strengthen the opening hook, or reframe the thesis with a contrarian perspective.
            </p>
          </div>
          <div class="flex items-center gap-1.5 flex-wrap text-[10px] font-mono text-text-secondary">
            <span class="px-2.5 py-1 rounded-md bg-surface border border-border-crisp">⚡ Shorten</span>
            <span class="px-2.5 py-1 rounded-md bg-surface border border-border-crisp">🔥 Stronger Hook</span>
            <span class="px-2.5 py-1 rounded-md bg-surface border border-border-crisp">🎯 Contrarian</span>
          </div>
        </div>

        <!-- Large Card 4 (Span 2) -->
        <div class="md:col-span-2 p-7 sm:p-9 rounded-2xl bg-base border border-border-crisp space-y-4 hover:border-border-highlight transition-colors">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-accent uppercase tracking-wider">04 · Cloud History & Database</span>
            <span class="text-[11px] font-mono text-text-secondary">Supabase PostgreSQL Backing</span>
          </div>
          <h3 class="text-xl font-bold text-text-primary">Every generation is safely archived and searchable.</h3>
          <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
            Never lose an idea. Every morphed draft is stored in your private history. Search previous outputs, re-copy snippets, and maintain a centralized library across desktop and mobile devices.
          </p>
          <div class="pt-2 flex flex-wrap items-center gap-4 text-xs font-mono text-text-secondary">
            <span class="flex items-center gap-1 text-accent font-semibold">• Row Level Security (RLS) protected</span>
            <span>• 1-Click Clipboard snippet copy</span>
            <span>• Device cross-sync</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Pricing Section (Asymmetrical Hierarchy, Starter Pack Featured) -->
  <section id="pricing" class="py-20 border-b border-border-crisp bg-base">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      
      <div class="text-center max-w-xl mx-auto mb-14">
        <span class="text-[11px] font-mono uppercase tracking-wider text-accent font-bold">Predictable Pricing</span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-text-primary tracking-tight mt-1">Pay only for what you repurpose.</h2>
        <p class="text-xs sm:text-sm text-text-secondary mt-2">No recurring subscriptions or hidden cancellation terms. Credits never expire.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
        
        <!-- Tier 1: Free Trial -->
        <div class="p-7 sm:p-8 rounded-2xl bg-surface border border-border-crisp flex flex-col justify-between space-y-6 shadow-sm">
          <div class="space-y-4">
            <div>
              <span class="text-xs font-mono font-bold text-text-secondary uppercase">Trial</span>
              <h3 class="text-xl font-bold text-text-primary mt-0.5">Free Account</h3>
              <p class="text-xs text-text-secondary mt-1">Test the repurposing engine with zero payment.</p>
            </div>
            <div class="pt-4 border-t border-border-crisp">
              <span class="text-3xl font-extrabold text-text-primary">₹0</span>
              <span class="text-xs font-mono text-text-secondary">/ on signup</span>
            </div>
            <div class="space-y-2 text-xs text-text-secondary font-mono pt-2">
              <p>• 5 Generation credits on signup</p>
              <p>• All 3 format outputs included</p>
              <p>• In-app draft editor access</p>
            </div>
          </div>
          <a href="repurpose_studio_responsive/code.html" class="w-full py-3 rounded-xl border border-border-crisp bg-subtle hover:bg-subtle-hover text-text-primary text-xs font-semibold text-center transition-colors">
            Start Free
          </a>
        </div>

        <!-- Tier 2: Starter Pack (FEATURED HERO CARD - Deep Carbon with White Text) -->
        <div class="p-7 sm:p-8 rounded-2xl bg-primary text-white border-2 border-accent flex flex-col justify-between space-y-6 shadow-xl relative">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
